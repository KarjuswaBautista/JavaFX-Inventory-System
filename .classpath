<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="Controllers/|DataBase/|FXMLFiles/|Main/|ImageFolder/" kind="src" path="src"/>
	<classpathentry kind="lib" path="lib/fontawesomefx-8.2.jar"/>
	<classpathentry kind="lib" path="lib/mysql-connector-j-9.1.0.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.USER_LIBRARY/JavaFX SDK 23"/>
	<classpathentry kind="output" path="build/classes"/>
</classpath>
